APP_NAME=Meetingkeun
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://meetingkeun.example.com
SANCTUM_STATEFUL_DOMAINS=meetingkeun.example.com
SESSION_SECURE_COOKIE=true

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Database (Produksi: pgsql atau mysql)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=meetingkeun
DB_USERNAME=meetingkeun
DB_PASSWORD=

# Cache & Session (Produksi: redis)
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Media Server (Jitsi JWT)
JITSI_DOMAIN=meet.perpusdigital.com
JITSI_APP_ID=meetingkeun
JITSI_APP_SECRET=ganti-dengan-secret-panjang-minimal-32-karakter
JITSI_JWT_TTL_MINUTES=120
